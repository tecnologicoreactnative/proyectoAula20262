# ============================================================================
# Variables de entorno del Modelo (configuración de Firebase)
# ----------------------------------------------------------------------------
# Estos valores alimentan `src/config/fbConfig.js`, el punto de inicialización
# del Modelo de datos (Firestore) y autenticación (Firebase Auth) que
# consumen los servicios (`src/services/*`) y, en última instancia, las
# Vistas a través del VistaModelo (`src/contexts/userContext.js`).
# Copia este archivo como `.env` y reemplaza los valores por los de tu
# proyecto Firebase. `.env` está excluido de git (ver .gitignore).
# Obtén estos valores en Firebase Console > Configuración del proyecto > Tus apps.
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
